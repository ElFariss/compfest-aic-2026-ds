# Server-only. Enable the Google Routes API and restrict this key to the backend's public IP.
GOOGLE_MAP_API=

# Replace before accepting telemetry from real devices.
IOT_SHARED_SECRET=replace-with-a-long-random-secret

# The MVP binds to loopback by default. Do not expose it publicly without dispatcher authentication.
HOST=127.0.0.1
PORT=8080

# Open road-routing fallback for the hackathon. Replace with a self-hosted Indonesia OSRM URL in production.
OSRM_BASE_URL=https://router.project-osrm.org

# 38-province GeoJSON source. The backend validates the expected province count before serving it.
REGION_GEOJSON_URL=https://raw.githubusercontent.com/AlfianAliM/Indonesia-GeoJSON/master/provinsi.geojson
